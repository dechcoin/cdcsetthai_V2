# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID: preferred source for trade alerts.
# Keeping the token in the environment (instead of bot_state.json) prevents it
# from being committed to git. Get these from @BotFather and @userinfobot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# DASHBOARD_TOKEN: required for every production /api/* request.
# Use a long random value; enter it in the dashboard Settings → Security tab.
DASHBOARD_TOKEN=""

# LIVE_KEYS_ENCRYPTION_KEY: required before the server accepts/stores broker or
# Telegram secrets. Keep this stable and private, separate from bot_state.json.
# Supply at least 32 random characters via the deployment's secret manager.
LIVE_KEYS_ENCRYPTION_KEY=""
